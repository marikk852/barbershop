generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  DONE
}

/// См. Booking.source ниже.
enum BookingSource {
  SITE
  MANUAL
}

enum AdminUserStatus {
  /// Telegram-подпись прошла проверку, но доступа ещё нет — запись
  /// появляется здесь САМА при первой попытке открыть админку (см.
  /// requireAdmin() в lib/telegram-auth.ts), владельцу остаётся только
  /// выдать доступ на экране /admin/users, не выясняя чужой numeric id
  /// вручную через внешние боты.
  PENDING
  ACTIVE
}

/// Список аккаунтов Telegram, которым разрешён вход в /admin — ПОМИМО
/// владельца (ADMIN_TELEGRAM_ID из env, у него доступ всегда и он не
/// хранится здесь, чтобы не зависеть от состояния этой таблицы). Только
/// владелец может управлять этим списком (см. requireOwner()).
model AdminUser {
  id         String @id @default(cuid())
  /// Null — владелец разрешил доступ заранее ТОЛЬКО по нику (username),
  /// человек ещё ни разу не открывал бота, поэтому numeric id неизвестен.
  /// Заполняется сам при первом успешном входе с совпадающим username
  /// (см. requireAdmin() в lib/telegram-auth.ts) — Telegram не даёт
  /// боту узнать id по нику иначе, это НЕ выбор архитектуры, а
  /// ограничение платформы.
  telegramId String? @unique
  username   String?

  firstName String?
  lastName  String?
  status    AdminUserStatus @default(PENDING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([username])
}

/// Услуга из прайс-листа. Длительность в минутах — основа расчёта слотов записи.
model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameRu      String
  nameRo      String
  durationMin Int
  priceCents  Int
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookingServices BookingService[]

  @@index([active, order])
}

/// Запись клиента. Одна запись — одно ВРЕМЯ (startsAt/endsAt), но может
/// включать НЕСКОЛЬКО услуг сразу (см. BookingService) — endsAt считается
/// как startsAt + СУММА durationMin всех выбранных услуг. startsAt/endsAt
/// хранятся в UTC явно (endsAt фиксируется в момент создания — последующее
/// изменение durationMin у Service не должно задним числом менять уже
/// сделанные записи, см. тот же принцип на BookingService.durationMin).
model Booking {
  id          String        @id @default(cuid())
  clientName  String
  /// Необязателен для source=MANUAL (см. ниже) — уличный клиент часто не
  /// оставляет номер барберу. Для source=SITE публичный API (/api/
  /// booking) всё равно требует его на уровне валидации запроса — схема
  /// это не проверяет (Prisma-констрейнт не умеет "required только при
  /// определённом значении другого поля"), контроль остаётся в route.ts.
  /// NULL нельзя группировать с другим NULL как "один и тот же клиент" в
  /// аналитике (см. src/lib/analytics.ts) — там на этот случай отдельная
  /// логика.
  clientPhone String?
  /// Необязательный — если клиент указал, шлём на него письмо при
  /// подтверждении/отмене записи (см. src/lib/mailer.ts).
  clientEmail String?
  startsAt    DateTime
  endsAt      DateTime
  status      BookingStatus @default(PENDING)
  notes       String?

  /// SITE — обычная заявка через публичную форму (/api/booking).
  /// MANUAL — барбер внёс запись сам в админке (визит вне сайта: звонок,
  /// уличный клиент) — см. POST /api/admin/bookings. Только визуальная
  /// пометка в списке "Заявки" ("Внесено вручную") — на подсчёт в
  /// аналитике не влияет (там DONE есть DONE независимо от источника,
  /// в этом и был смысл всей задачи — учитывать оффлайн-визиты наравне
  /// с онлайн).
  source BookingSource @default(SITE)

  /// id сообщения в Telegram-боте с кнопками подтверждения — чтобы потом
  /// отредактировать то же сообщение вместо отправки нового (задача #8).
  telegramMessageId Int?

  /// chat_id клиента в Telegram — заполняется, когда клиент переходит по
  /// ссылке "Получать уведомления в Telegram" на экране успеха (deep
  /// link ?start=<id этой записи>) и жмёт /start у бота (см. /api/
  /// telegram/webhook). NULL, если клиент не переходил по ссылке —
  /// тогда уведомление о статусе шлётся только на email (если указан).
  clientTelegramChatId BigInt?

  /// Язык сайта, на котором клиент оформлял заявку ("ru"/"ro", см.
  /// src/i18n/routing.ts) — уведомления о смене статуса (email, Telegram
  /// клиенту) шлются ТОЛЬКО на этом языке, а не двуязычно. По умолчанию
  /// "ru" (дефолтная локаль сайта) — покрывает и старые записи до этого
  /// поля, и любой сбой определения локали на клиенте.
  locale String @default("ru")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services BookingService[]

  @@index([startsAt])
  @@index([status])
}

/// Одна услуга внутри записи (Booking — BookingService — Service,
/// многие-ко-многим с полезной нагрузкой). durationMin/priceCents —
/// СНИМОК на момент создания записи (тот же принцип, что и у
/// Booking.endsAt) — изменение цены/длительности услуги впоследствии не
/// должно задним числом менять уже оформленные записи/чеки. onDelete:
/// Restrict на service — как и раньше, нельзя удалить услугу, если на
/// неё есть хоть одна историческая запись (снимок сохраняет цифры, но
/// само название/язык услуги всё ещё читается через живую связь).
model BookingService {
  id          String  @id @default(cuid())
  bookingId   String
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  durationMin Int
  priceCents  Int

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([serviceId])
}

/// График работы по дням недели. weekday: 0=воскресенье..6=суббота (как JS Date#getDay).
/// startMinute/endMinute — минуты от полуночи, без временных зон.
model WorkingHours {
  id          String  @id @default(cuid())
  weekday     Int     @unique
  startMinute Int
  endMinute   Int
  closed      Boolean @default(false)
}

/// Разовые блокировки времени: отпуск, обед, личные дела.
model TimeOff {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([startsAt, endsAt])
}

/// Работа для портфолио.
model PortfolioItem {
  id        String   @id @default(cuid())
  imageUrl  String
  captionRu String?
  captionRo String?
  /// Реальные пиксельные размеры исходника — читаются в браузере при
  /// загрузке (см. admin/portfolio/page.tsx) и передаются на сервер вместе
  /// с imageUrl. Нужны публичной сетке портфолио для масонри-раскладки:
  /// каждое фото показывается в своей настоящей пропорции (без обрезки/
  /// чёрных полей), а next/image без fill требует width/height заранее,
  /// не дожидаясь загрузки самого файла на клиенте.
  width     Int?
  height    Int?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([order])
}

/// Редактируемый контент сайта — одна строка (singleton, id всегда 1).
model SiteContent {
  id               Int      @id @default(1)
  bioRu            String   @default("")
  bioRo            String   @default("")
  phone            String?
  instagram        String?
  telegramUsername String?
  address          String?
  updatedAt        DateTime @updatedAt
}
