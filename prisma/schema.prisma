generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  DONE
}

enum AdminUserStatus {
  /// Telegram-подпись прошла проверку, но доступа ещё нет — запись
  /// появляется здесь САМА при первой попытке открыть админку (см.
  /// requireAdmin() в lib/telegram-auth.ts), владельцу остаётся только
  /// выдать доступ на экране /admin/users, не выясняя чужой numeric id
  /// вручную через внешние боты.
  PENDING
  ACTIVE
}

/// Список аккаунтов Telegram, которым разрешён вход в /admin — ПОМИМО
/// владельца (ADMIN_TELEGRAM_ID из env, у него доступ всегда и он не
/// хранится здесь, чтобы не зависеть от состояния этой таблицы). Только
/// владелец может управлять этим списком (см. requireOwner()).
model AdminUser {
  id         String @id @default(cuid())
  /// Null — владелец разрешил доступ заранее ТОЛЬКО по нику (username),
  /// человек ещё ни разу не открывал бота, поэтому numeric id неизвестен.
  /// Заполняется сам при первом успешном входе с совпадающим username
  /// (см. requireAdmin() в lib/telegram-auth.ts) — Telegram не даёт
  /// боту узнать id по нику иначе, это НЕ выбор архитектуры, а
  /// ограничение платформы.
  telegramId String? @unique
  username   String?

  firstName String?
  lastName  String?
  status    AdminUserStatus @default(PENDING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([username])
}

/// Услуга из прайс-листа. Длительность в минутах — основа расчёта слотов записи.
model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameRu      String
  nameRo      String
  durationMin Int
  priceCents  Int
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings Booking[]

  @@index([active, order])
}

/// Запись клиента. startsAt/endsAt хранятся в UTC явно (endsAt фиксируется
/// в момент создания = startsAt + длительность услуги на тот момент —
/// последующее изменение durationMin у Service не должно задним числом
/// менять уже сделанные записи).
model Booking {
  id          String        @id @default(cuid())
  serviceId   String
  service     Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  clientName  String
  clientPhone String
  /// Необязательный — если клиент указал, шлём на него письмо при
  /// подтверждении/отмене записи (см. src/lib/mailer.ts).
  clientEmail String?
  startsAt    DateTime
  endsAt      DateTime
  status      BookingStatus @default(PENDING)
  notes       String?

  /// id сообщения в Telegram-боте с кнопками подтверждения — чтобы потом
  /// отредактировать то же сообщение вместо отправки нового (задача #8).
  telegramMessageId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt])
  @@index([status])
}

/// График работы по дням недели. weekday: 0=воскресенье..6=суббота (как JS Date#getDay).
/// startMinute/endMinute — минуты от полуночи, без временных зон.
model WorkingHours {
  id          String  @id @default(cuid())
  weekday     Int     @unique
  startMinute Int
  endMinute   Int
  closed      Boolean @default(false)
}

/// Разовые блокировки времени: отпуск, обед, личные дела.
model TimeOff {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([startsAt, endsAt])
}

/// Работа для портфолио.
model PortfolioItem {
  id        String   @id @default(cuid())
  imageUrl  String
  captionRu String?
  captionRo String?
  /// Реальные пиксельные размеры исходника — читаются в браузере при
  /// загрузке (см. admin/portfolio/page.tsx) и передаются на сервер вместе
  /// с imageUrl. Нужны публичной сетке портфолио для масонри-раскладки:
  /// каждое фото показывается в своей настоящей пропорции (без обрезки/
  /// чёрных полей), а next/image без fill требует width/height заранее,
  /// не дожидаясь загрузки самого файла на клиенте.
  width     Int?
  height    Int?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([order])
}

/// Редактируемый контент сайта — одна строка (singleton, id всегда 1).
model SiteContent {
  id               Int      @id @default(1)
  bioRu            String   @default("")
  bioRo            String   @default("")
  phone            String?
  instagram        String?
  telegramUsername String?
  address          String?
  updatedAt        DateTime @updatedAt
}
